<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <modelVersion>4.0.0</modelVersion>
  <groupId>com.moon.mediavision</groupId>
  <artifactId>mediavision-sdk</artifactId>
  <version>0.4.0</version>
  <packaging>aar</packaging>
  <name>Moon MediaVision SDK</name>
  <description>Binary SDK for real-time portrait effects, native rendering and platform-adapted acceleration.</description>
  <url>https://github.com/qmy1990/MediaVision</url>
  <licenses>
    <license>
      <name>Moon MediaVision SDK Binary Integration License</name>
      <url>https://github.com/qmy1990/MediaVision/blob/main/licenses/SDK-BINARY-LICENSE.txt</url>
    </license>
  </licenses>
  <developers>
    <developer>
      <id>moon</id>
      <name>Moon</name>
    </developer>
  </developers>
  <dependencies>
    <dependency>
      <groupId>com.google.mediapipe</groupId>
      <artifactId>tasks-vision</artifactId>
      <version>0.10.28</version>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>com.google.ai.edge.litert</groupId>
      <artifactId>litert</artifactId>
      <version>1.4.2</version>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>com.google.ai.edge.litert</groupId>
      <artifactId>litert-gpu</artifactId>
      <version>1.4.2</version>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>com.google.ai.edge.litert</groupId>
      <artifactId>litert-gpu-api</artifactId>
      <version>1.4.2</version>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>com.qualcomm.qti</groupId>
      <artifactId>qnn-runtime</artifactId>
      <version>2.45.0</version>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>com.qualcomm.qti</groupId>
      <artifactId>qnn-litert-delegate</artifactId>
      <version>2.45.0</version>
      <scope>runtime</scope>
    </dependency>
  </dependencies>
</project>
